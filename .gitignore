# Build artifacts (regenerated from source by bin/build-zip.sh)
claudpress.zip
build/

# Composer is DEV TOOLING ONLY here (PHPStan). The plugin itself has no runtime
# dependencies: `require` in composer.json is deliberately empty, no Composer
# autoloader is registered, and bin/build-zip.sh never copies this directory
# into the zip. Nothing under vendor/ ships, so nothing under vendor/ is tracked.
vendor/

# composer.lock IS committed on purpose — do not add it here.
#
# The only dependency is the analyser, and the analyser has a committed
# baseline. Floating the analyser against a fixed baseline is how CI goes red on
# a commit that changed no code: PHPStan routinely adds rules in patch releases,
# and every new rule becomes an unbaselined error. The lock pins it, so
# upgrading PHPStan is a deliberate `composer update` that regenerates the
# baseline in the same commit. It also makes the CI cache key mean something.

# PHPStan's result cache
.phpstan-cache/

# Code index (local only)
.codegraph/

# OS / editor junk
.DS_Store
Thumbs.db
*.log
.idea/
.vscode/

# Local env / secrets (never commit tokens or API keys)
.env
*.local

# Holds a live bearer token for the staging site. Never commit.
.staging-token

# Private working docs. They live in ../claudpress-vital/ and are deliberately
# outside this repository, because this repository is public.
#
# They are the business plan the project used to have: tier tables, price
# points, conversion levers, a rebrand plan, and pre-launch audits of a live
# site. None of it describes how the plugin works, and publishing a site's own
# security findings helps nobody but an attacker.
#
# Listed by name as well as by path so a stray `git add -f` from the wrong
# directory still cannot bring one back.
TASKS.md
docs/audits/
docs/ops/
docs/plans/free-pro-split.md
docs/plans/rebrand.md
docs/design-system-brief.md

# Browser-check artifacts. Regenerated on every failing run.
tests/rig/ui/failures/
node_modules/
